# Copy this to .env.local and fill in your Cloudflare Pages environment variables
# These are SERVER-SIDE variables used by functions/presign.js
# Do NOT prefix with VITE_ — they must never appear in the frontend bundle

# Not needed in .env.local — these are set in Cloudflare Pages dashboard:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-api-token-access-key
# R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
# R2_BUCKET=your-bucket-name

# For local dev with wrangler (pages dev), add to .dev.vars instead:
# https://developers.cloudflare.com/pages/functions/local-development/
